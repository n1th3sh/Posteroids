# PostgreSQL JDBC URL. For Neon, use its direct JDBC URL (jdbc:postgresql://... with sslmode=require).
JDBC_DATABASE_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Generate a unique random secret of at least 32 bytes for each environment.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRATION_MS=86400000

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_API_HOST/api/login/oauth2/code/google

# Frontend deployment origin, no trailing slash. Add local dev origins comma-separated in CORS_ALLOWED_ORIGINS.
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN,http://localhost:3000,http://localhost:5173

# SMTP provider credentials for verification mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@YOUR_DOMAIN
EMAIL_CODE_EXPIRATION_MINUTES=10
